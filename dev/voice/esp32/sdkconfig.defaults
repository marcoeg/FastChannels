# Minny satellite — Waveshare ESP32-S3-AUDIO-Board.
# Secrets (WiFi credentials + LiveKit token) live in sdkconfig.secrets.defaults
# (git-excluded, generated by gen_secrets.py); build with ./build.sh so both
# files are applied.

CONFIG_IDF_TARGET="esp32s3"

CONFIG_LK_SERVER_URL="ws://192.168.50.17:7880"
# Louder default: 70 was reported too quiet on the NS4150B/speaker combo.
CONFIG_SPEAKER_VOLUME=85

# Infinite WiFi retries: with the default 10, a router outage longer than a
# few seconds permanently bricks the satellite until a power cycle
# (example_utils stops retrying and nothing restarts it).
CONFIG_LK_EXAMPLE_NETWORK_MAX_RETRIES=-1

# ICE candidate bursts overflowed the engine's event queue during connect
# ("Failed to enqueue event") — give it headroom.
CONFIG_LK_ENGINE_QUEUE_SIZE=32

#
# LiveKit SDK requirements (from the custom_hardware example — keep verbatim)
#
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_WS_CLIENT_ENABLE_DYNAMIC_BUFFER=y
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_PARTITION_TABLE_CUSTOM=y

#
# Board: ESP32-S3R8 — 16 MB quad flash (QIO/80M) + 8 MB octal PSRAM
#
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
# NOTE: deliberately NOT setting CONFIG_SPIRAM_RODATA (the Waveshare demo
# does): it moves the esp-sr AEC's FFT coefficient tables into octal PSRAM,
# and the resulting data-cache thrash made AEC slower than real time —
# buffer_in/afe_feed pegged CPU0 and starved the idle task. The LiveKit
# reference configs omit it too.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
# Larger internal cushion than the LiveKit examples (8192): this firmware
# also runs LVGL, and engine bring-up died of internal-heap exhaustion with
# the small reserve.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_USE_MALLOC=y

#
# On-device wake word (esp-sr WakeNet, standalone — NOT the AFE).
# Only "Hey Wanda" is packed; MultiNet and other wake words stay off
# (their Kconfig defaults are None/False), keeping srmodels.bin ~300 KB.
# Model lives in the `model` spiffs partition (partitions.csv).
#
CONFIG_SR_WN_WN9_HEYWANDA_TTS=y

#
# LVGL
#
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_BUILD_EXAMPLES=n
# LVGL's pool is plain internal RAM; the default 64K starved the LiveKit
# engine (FreeRTOS queues/task stacks are internal-only) — the status UI
# needs far less.
CONFIG_LV_MEM_SIZE_KILOBYTES=24

{
  "version": "2026-10-07",
  "about": "Request templates for sft_gen.py. Phrasings are taken from the household's conversation log; slots are filled at generation time from the live lineup, the guide and the TV's on-demand catalogue, so every name in the traffic is real. Each template carries the checks that decide whether the teacher's turn is kept (rejection sampling).",
  "mix": {"log": 0.35, "single": 0.45, "multi": 0.20, "memory_share": 0.30},
  "slots": {
    "time_phrase": ["tonight", "this evening", "later today", "tomorrow morning", "tomorrow night", "this afternoon", "at eight tonight", "at nine tonight", "on Saturday", "after six", "on Sunday morning", "late tonight"],
    "hour": ["five", "six", "seven", "eight", "nine", "ten", "4", "5", "8"],
    "genre": ["news", "sports", "movies", "cooking shows", "comedies", "documentaries", "cartoons", "kids shows", "crime dramas", "game shows", "westerns", "music", "Spanish-language shows", "talk shows", "sitcoms", "nature documentaries"],
    "vod_category": ["comedies", "action movies", "family films", "dramas", "documentaries", "new releases", "something for the kids", "horror movies"],
    "ordinal": ["first", "second", "third", "last"],
    "level": ["twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "25", "35", "45", "75"],
    "closing": ["Great.", "Thanks!", "Thank you.", "Okay.", "Perfect, thanks.", "No, thank you.", "Cool.", "All right."],
    "dislike": ["reality shows", "horror", "game shows", "sports", "talk shows", "cartoons"],
    "misheard": [["Tune on trues.", "Trace"], ["I mean truths.", "Trace"], ["Put on cozy.", "COZI"], ["Tune to Kay Q E D.", "KQED"], ["Switch to K P I X.", "KPIX"], ["Put on eye on.", "ION HD"], ["Two non-press.", "Trace"], ["Tune on K T B U.", "KTVU"]],
    "garbled": ["Do you have any other way in it?", "This is a", "Is there any...", "Clay the farmer and the foodie catch up on Channel 9.", "Clay yesterday's new hours.", "Let's get you back out.", "Stop it. No, the other one.", "Mhm.", "Now tune the TV to Colombo.", "Is there any Colombo right now?", "Start BBS NewsHour from the beginning."]
  },
  "aliases": {
    "KTVU": ["Fox", "Fox 2", "channel 2", "KTVU"],
    "KPIX": ["CBS", "channel 5", "KPIX"],
    "KQED": ["PBS", "channel 9", "KQED", "channel nine"],
    "KNTV": ["NBC", "channel 11", "KNTV"],
    "KSTS": ["Telemundo", "channel 48", "KSTS"],
    "ION HD": ["ION", "channel 65", "ION HD"],
    "COZI": ["COZI", "Cozi TV", "channel 12"],
    "KQED2": ["KQED Plus", "channel 10", "KQED2"]
  },
  "memory": {
    "favourite_channel": "The user's favourite channel is {channel_name}.",
    "favourite_show": "The user's favourite show is {title_tonight}.",
    "dislike": "The user does not like {dislike}.",
    "normal_volume": "User's normal volume is {level_frac} ({level_pct}%).",
    "news_channel": "User's favorite news channel is {channel_name}."
  },
  "single": [
    {"id": "on_now", "weight": 8,
     "say": ["What's on TV right now?", "What is playing on TV?", "What is playing on TV right now?", "What's on right now?", "Anything good on?", "What's on the TV?"],
     "checks": {"tools_any_of": [["minny_whats_on_now"]]}},
    {"id": "on_now_channel", "weight": 6,
     "say": ["What's on {channel} right now?", "What is on {channel}?", "What's on channel {number}?", "What's playing on {channel}?"],
     "checks": {"tools_any_of": [["minny_whats_on_now"]]}},
    {"id": "tune", "weight": 10,
     "say": ["Tune to {channel}.", "Put on {channel}.", "Switch to {channel}.", "Turn on {channel}.", "Go to {channel}.", "Can you tune to {channel}?", "Put on {channel} please.", "Tune on {channel}."],
     "checks": {"tools_any_of": [["tv_watch_channel"]], "tool_args": [{"tool": "tv_watch_channel", "arg": "channel", "slot_regex": "channel"}]}},
    {"id": "tune_number", "weight": 5,
     "say": ["Switch to channel {number}.", "Channel {number}.", "Put on channel {number}.", "Turn on channel {number}.", "Tune to {number}."],
     "checks": {"tools_any_of": [["tv_watch_channel"]], "tool_args": [{"tool": "tv_watch_channel", "arg": "channel", "slot_regex": "number"}]}},
    {"id": "title_schedule", "weight": 8,
     "say": ["Is there any {title_tonight} tonight?", "Is {title_tonight} on {time_phrase}?", "When is {title_tonight} on?", "What time can I watch {title_tonight}?", "When is the next {title_tonight} on {channel}?", "Do we have {title_tonight} today or tomorrow?"],
     "checks": {"tools_any_of": [["minny_search_live_schedule"]]}},
    {"id": "title_now", "weight": 4,
     "say": ["Is {title_now} on right now?", "Is there any {title_now} on?", "Is {title_now} playing now?"],
     "checks": {"tools_any_of": [["minny_whats_on_now"], ["minny_search_live_schedule"], ["minny_whats_on_now", "minny_search_live_schedule"]]}},
    {"id": "genre_schedule", "weight": 7,
     "say": ["Any {genre} on {time_phrase}?", "Is there any {genre} {time_phrase}?", "What {genre} can I watch {time_phrase}?", "Are there {genre} {time_phrase}?"],
     "checks": {"tools_any_of": [["minny_search_live_schedule"]]}},
    {"id": "genre_now", "weight": 4,
     "say": ["Is there any {genre} on right now?", "Any {genre} on now?", "Is there any live {genre} on TV right now?"],
     "checks": {"tools_any_of": [["minny_whats_on_now"], ["minny_search_live_schedule"]]}},
    {"id": "whats_next", "weight": 4,
     "say": ["What's on next on {channel}?", "What's after this on {channel}?", "What comes next on {channel}?"],
     "checks": {"tools_any_of": [["minny_search_live_schedule"]]}},
    {"id": "channel_schedule", "weight": 5,
     "say": ["What's on {channel} {time_phrase}?", "Give me {channel}'s schedule for {time_phrase}.", "What does {channel} have {time_phrase}?"],
     "checks": {"tools_any_of": [["minny_search_live_schedule"]]}},
    {"id": "movies", "weight": 5,
     "say": ["Any movie I can watch at around {hour} o'clock today?", "What movies are on {time_phrase}?", "Is there a movie from the nineties on {time_phrase}?", "What movie can I watch {time_phrase}?"],
     "checks": {"tools_any_of": [["minny_search_live_schedule"], ["minny_search_live_schedule", "tv_on_demand"], ["tv_on_demand", "minny_search_live_schedule"]]}},
    {"id": "recommend", "weight": 5,
     "say": ["What should I watch {time_phrase}?", "Anything good on {time_phrase}?", "Recommend me something for {time_phrase}.", "What can I watch {time_phrase}?"],
     "checks": {"tools_any_of": [["minny_search_live_schedule"], ["minny_search_live_schedule", "minny_whats_on_now"], ["minny_whats_on_now", "minny_search_live_schedule"], ["minny_whats_on_now"]]}},
    {"id": "play_live_title", "weight": 5,
     "say": ["Play {title_now}.", "Put on {title_now}.", "Start {title_now}.", "I want to watch {title_now}."],
     "checks": {"tools_any_of": [["tv_watch_title"], ["tv_watch_channel"], ["tv_watch_title", "tv_watch_channel"]]}},
    {"id": "play_vod", "weight": 5,
     "say": ["Play {vod_title}.", "Put on {vod_title}.", "I'd like to watch {vod_title}."],
     "checks": {"tools_any_of": [["tv_watch_title"], ["tv_play_asset"], ["tv_watch_title", "tv_play_asset"]]}},
    {"id": "vod_browse", "weight": 5,
     "say": ["What's on demand?", "Any {vod_category} on demand?", "What can I watch later on demand?", "What is on demand that I can watch later?", "Anything for the kids on demand?"],
     "checks": {"tools_any_of": [["tv_on_demand"]]}},
    {"id": "catchup", "weight": 5,
     "say": ["Play the {title_now} catch-up on {channel}.", "Can I catch up on {title_now}?", "Play yesterday's {title_now}.", "I want to watch a catch-up of {title_now}.", "What can I catch up on from {channel}?"],
     "checks": {"tools_any_of": [["tv_watch_title"], ["minny_search_catchup"], ["minny_search_catchup", "tv_play_airing"]]}},
    {"id": "restart", "weight": 3,
     "say": ["Restart {title_now} from the beginning.", "Start {title_now} over.", "Can you restart {title_now} from the beginning?"],
     "checks": {"tools_any_of": [["tv_watch_title"], ["tv_play_airing"], ["minny_whats_on_now", "tv_play_airing"], ["tv_watch_title", "tv_play_airing"]]}},
    {"id": "volume_up", "weight": 4,
     "say": ["Turn it up.", "Louder.", "Turn the volume up a bit.", "A bit louder please.", "Turn it up a lot."],
     "checks": {"tools_any_of": [["tv_volume"]], "tool_args": [{"tool": "tv_volume", "arg": "change", "regex": "(?i)up|set"}]}},
    {"id": "volume_down", "weight": 4,
     "say": ["Turn it down.", "Quieter please.", "Turn the volume down a bit.", "Lower the volume.", "Turn it down a lot."],
     "checks": {"tools_any_of": [["tv_volume"]], "tool_args": [{"tool": "tv_volume", "arg": "change", "regex": "(?i)down|set"}]}},
    {"id": "volume_set", "weight": 4,
     "say": ["Set the volume to {level} percent.", "Volume {level} percent.", "Put the volume at {level}.", "Set the volume to {level}."],
     "checks": {"tools_any_of": [["tv_volume"]], "tool_args": [{"tool": "tv_volume", "args": {"change": "set", "level": "{level_frac}"}}]}},
    {"id": "mute", "weight": 2, "say": ["Mute it.", "Mute the TV.", "Mute the volume."], "checks": {"tools_any_of": [["tv_mute"]]}},
    {"id": "unmute", "weight": 2, "say": ["Unmute.", "Unmute the TV.", "Sound back on."], "checks": {"tools_any_of": [["tv_unmute"], ["tv_volume"]]}},
    {"id": "pause", "weight": 2, "say": ["Pause it.", "Pause.", "Pause the TV."], "checks": {"tools_any_of": [["tv_pause"]]}},
    {"id": "resume", "weight": 2, "say": ["Resume.", "Play.", "Continue."], "checks": {"tools_any_of": [["tv_play"]]}},
    {"id": "stop", "weight": 2, "say": ["Stop.", "Stop the TV.", "Close the player."], "checks": {"tools_any_of": [["tv_stop"]]}},
    {"id": "watching", "weight": 4,
     "say": ["What am I watching?", "What am I watching right now?", "What is it playing right now?", "What's on my TV right now?"],
     "screen": "tuned",
     "checks": {"tools_any_of": [[], ["tv_get_state"], ["minny_whats_on_now"]]}},
    {"id": "about_episode", "weight": 3,
     "say": ["What is this episode about?", "What's this show about?", "What is this about?"],
     "screen": "tuned",
     "checks": {"tools_any_of": [["minny_whats_on_now"], ["minny_whats_on_now", "web_lookup"], ["web_lookup"]]}},
    {"id": "about_title", "weight": 3,
     "say": ["Is {vod_title} any good?", "Who's in {vod_title}?", "Who directed {vod_title}?", "What year is {vod_title} from?"],
     "checks": {"tools_any_of": [["web_lookup"], []]}},
    {"id": "memory_store", "weight": 4,
     "say": ["Remember that my favorite channel is {channel}.", "My normal volume is {level_frac}.", "I don't like {dislike}.", "My favorite show is {title_tonight}.", "Remember that my favorite news channel is {channel}.", "Always set the volume to {level} when I say turn it up."],
     "checks": {"tools_any_of": [[]]}},
    {"id": "memory_use_channel", "weight": 3, "memory": ["favourite_channel"],
     "say": ["What's my favorite channel?", "What is my favorite channel?", "Put on my favorite channel."],
     "checks": {"tools_any_of": [[], ["search_memory"], ["tv_watch_channel"]], "answer_match_slot": "channel"}},
    {"id": "memory_use_volume", "weight": 2, "memory": ["normal_volume"],
     "say": ["Put the volume back to normal.", "Set the volume to my usual level."],
     "checks": {"tools_any_of": [["tv_volume"]], "tool_args": [{"tool": "tv_volume", "args": {"change": "set", "level": "{level_frac}"}}]}},
    {"id": "memory_use_news", "weight": 2, "memory": ["news_channel"],
     "say": ["What is my favorite news channel?", "Put on my news channel."],
     "checks": {"tools_any_of": [[], ["search_memory"], ["tv_watch_channel"]]}},
    {"id": "identity", "weight": 3,
     "say": ["Hey Minny.", "Hi Minnie.", "Who are you?", "What can you do?", "Hey Wanda.", "hi, who are you?", "Minny."],
     "checks": {"tools_any_of": [[]]}},
    {"id": "limits", "weight": 3,
     "say": ["Record {title_tonight} tonight.", "Turn on captions.", "Can you set a timer to turn on {title_tonight} when it starts?", "Go back to the last channel.", "Tune on the next channel.", "Can you record {title_now} for me?", "Turn captions off."],
     "checks": {"tools_any_of": [[], ["minny_search_live_schedule"]]}},
    {"id": "closing", "weight": 2,
     "say": ["{closing}"],
     "checks": {"tools_any_of": [[]], "max_answer_chars": 60}},
    {"id": "garbled", "weight": 3,
     "say": ["{garbled}"],
     "checks": {"tools_any_of": [[], ["tv_watch_channel"], ["tv_watch_title"], ["minny_find_channels"], ["minny_whats_on_now"], ["minny_search_catchup"], ["minny_search_live_schedule"]]}}
  ],
  "multi": [
    {"id": "m_on_now_tune", "weight": 4,
     "turns": [{"say": ["What's on TV right now?", "What is playing on TV?"], "checks": {"tools_any_of": [["minny_whats_on_now"]]}},
               {"say": ["Turn that channel on.", "Put the first one on.", "Can you tune to that channel?"], "checks": {"tools_any_of": [["tv_watch_channel"], []]}},
               {"say": ["What am I watching?"], "checks": {"tools_any_of": [[], ["tv_get_state"], ["minny_whats_on_now"]]}}]},
    {"id": "m_vod_ordinal", "weight": 3,
     "turns": [{"say": ["Any {vod_category} on demand?", "What's on demand?"], "checks": {"tools_any_of": [["tv_on_demand"]]}},
               {"say": ["The {ordinal} one."], "checks": {"tools_any_of": [["tv_play_asset"], ["tv_watch_title"]]}}]},
    {"id": "m_schedule_followups", "weight": 3,
     "turns": [{"say": ["Is there any {title_tonight} tonight?", "When is {title_tonight} on?"], "checks": {"tools_any_of": [["minny_search_live_schedule"]]}},
               {"say": ["And what is after that?", "What's on after that?"], "checks": {"tools_any_of": [["minny_search_live_schedule"], []]}},
               {"say": ["How long does it last?"], "checks": {"tools_any_of": [[], ["minny_search_live_schedule"]]}}]},
    {"id": "m_ambiguous_channel", "weight": 3,
     "turns": [{"say": ["Put on {channel_prefix}.", "Tune to {channel_prefix}."], "checks": {"tools_any_of": [["tv_watch_channel"], ["tv_watch_title"], []]}},
               {"say": ["{channel_full}."], "checks": {"tools_any_of": [["tv_watch_channel"]], "tool_args": [{"tool": "tv_watch_channel", "arg": "channel", "slot_regex": "channel_full"}]}}]},
    {"id": "m_tune_volume", "weight": 3,
     "turns": [{"say": ["Tune to {channel}."], "checks": {"tools_any_of": [["tv_watch_channel"]]}},
               {"say": ["Turn it up."], "checks": {"tools_any_of": [["tv_volume"]], "tool_args": [{"tool": "tv_volume", "args": {"change": "up"}}]}},
               {"say": ["Quieter please."], "checks": {"tools_any_of": [["tv_volume"]], "tool_args": [{"tool": "tv_volume", "args": {"change": "down"}}]}},
               {"say": ["Mute it."], "checks": {"tools_any_of": [["tv_mute"]]}},
               {"say": ["Turn it up."], "checks": {"tools_any_of": [["tv_volume"]], "tool_args": [{"tool": "tv_volume", "args": {"change": "up"}}]}}]},
    {"id": "m_tune_about", "weight": 2,
     "turns": [{"say": ["Tune to {channel}."], "checks": {"tools_any_of": [["tv_watch_channel"]]}},
               {"say": ["What is this episode about?", "What's this about?"], "checks": {"tools_any_of": [["minny_whats_on_now"], ["minny_whats_on_now", "web_lookup"], ["web_lookup"]]}}]},
    {"id": "m_misheard_channel", "weight": 3,
     "turns": [{"say": ["{misheard_text}"], "checks": {"tools_any_of": [[], ["tv_watch_channel"], ["minny_find_channels"], ["tv_watch_title"]]}},
               {"say": ["I meant {misheard_channel}.", "No, {misheard_channel}."], "checks": {"tools_any_of": [["tv_watch_channel"], []], "tool_args": [{"tool": "tv_watch_channel", "arg": "channel", "slot_regex": "misheard_channel"}]}}]},
    {"id": "m_channel_schedule_tune", "weight": 2,
     "turns": [{"say": ["What's on {channel} tonight?"], "checks": {"tools_any_of": [["minny_search_live_schedule"]]}},
               {"say": ["Tune to it.", "Put it on."], "checks": {"tools_any_of": [["tv_watch_channel"]], "tool_args": [{"tool": "tv_watch_channel", "arg": "channel", "slot_regex": "channel"}]}}]},
    {"id": "m_vod_quality", "weight": 2,
     "turns": [{"say": ["Play {vod_title}."], "checks": {"tools_any_of": [["tv_watch_title"], ["tv_play_asset"]]}},
               {"say": ["Is it any good?", "Is that film any good?"], "checks": {"tools_any_of": [["web_lookup"], []]}}]},
    {"id": "m_action_closing", "weight": 3,
     "turns": [{"say": ["Tune to {channel}.", "Mute it.", "Turn it up."], "checks": {"tools_any_of": [["tv_watch_channel"], ["tv_mute"], ["tv_volume"]]}},
               {"say": ["{closing}"], "checks": {"tools_any_of": [[]], "max_answer_chars": 60}}]},
    {"id": "m_recommend_pick", "weight": 2, "memory": ["dislike"],
     "turns": [{"say": ["What should I watch tonight?", "Anything good on tonight?"], "checks": {"tools_any_of": [["minny_search_live_schedule"], ["minny_search_live_schedule", "minny_whats_on_now"], ["minny_whats_on_now", "minny_search_live_schedule"]]}},
               {"say": ["Put on the first one.", "The first one."], "checks": {"tools_any_of": [["tv_watch_channel"], ["tv_watch_title"], ["tv_play_airing"], []]}}]},
    {"id": "m_title_now_put_on", "weight": 2,
     "turns": [{"say": ["Is {title_now} on right now?"], "checks": {"tools_any_of": [["minny_whats_on_now"], ["minny_search_live_schedule"]]}},
               {"say": ["Put it on."], "checks": {"tools_any_of": [["tv_watch_channel"], ["tv_watch_title"]]}}]}
  ]
}

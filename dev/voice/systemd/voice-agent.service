[Unit]
Description=Voice worker (LiveKit agent, pydantic-ai brain)
After=network-online.target
# The two voice workers must never race for jobs in room "voice":
# starting this one stops the Hermes-backed fallback, and vice versa.
Conflicts=hermes-voice-agent.service

[Service]
Type=simple
Environment=PATH=/home/marco/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/marco/Development/FastChannels/dev/voice
ExecStart=/home/marco/Development/FastChannels/dev/voice/voice_agent.py start
# Heal rooms orphaned by the restart: jobs die with the worker but their
# rooms survive, and LiveKit never re-dispatches an agent to an existing
# room — the always-connected ESP32 satellite would stay agent-less until
# its room is deleted (the device's reconnect loop then recreates it and a
# fresh agent is dispatched). --after-restart waits for the new worker's
# health port, then deletes rooms whose clients and agents all joined before
# this restart — no fixed sleep, so the satellite is back in seconds (the
# dead job's agent lingering 20-60 s no longer matters). Detached, so
# activation isn't delayed.
ExecStartPost=/bin/sh -c '/home/marco/Development/FastChannels/dev/voice/heal_agentless_rooms.py --after-restart >>/tmp/voice-room-healer.log 2>&1 &'
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
